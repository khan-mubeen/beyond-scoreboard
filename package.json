{
  "name": "beyond-scoreboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "build": "vite build",
    "start": "tsx server/main.ts --prod",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "snapshot": "tsx features/liiga/scripts/snapshot.ts",
    "fake-players": "tsx features/live/scripts/fake-players.ts",
    "pregen": "tsx features/story/scripts/pregenerate-content.ts",
    "pregen:phrases": "tsx features/story/scripts/pregenerate-phrases.ts",
    "db:migrate": "tsx shared/db/migrate.ts",
    "db:seed": "tsx shared/db/seed.ts",
    "demo:reset": "tsx features/live/scripts/demo-reset.ts",
    "demo:pick": "tsx features/live/scripts/demo-pick.ts",
    "demo:videos": "tsx features/live/scripts/demo-videos.ts",
    "demo:cues": "tsx features/live/scripts/demo-cues.ts",
    "pregen:demo": "tsx features/story/scripts/pregenerate-content.ts --demo",
    "audio:generate": "tsx features/story/scripts/audio-generate.ts",
    "audio:import": "tsx features/story/scripts/audio-import.ts"
  },
  "dependencies": {
    "@supabase/realtime-js": "^2.118.0",
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.3.0",
    "motion": "^14.6.0",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "globals": "^17.13.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
