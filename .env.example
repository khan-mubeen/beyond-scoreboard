# copy to .env. everything is optional: with nothing set the app runs offline on the recorded
# snapshots, an in-memory database and template texts, and the browser polls instead of realtime.
# only VITE_* variables reach the browser bundle, and those must be safe to publish.

PORT=3000

# ---- liiga api (server only) ----
LIIGA_API_URL=
LIIGA_API_KEY=
# true: never call the api, serve features/liiga/snapshots/ (npm run snapshot records them)
USE_SNAPSHOT=true

# ---- supabase (server only) ----
SUPABASE_URL=
# the secret (service-role) key: bypasses rls. never give it a VITE_ prefix
SUPABASE_SECRET_KEY=
# only for npm run db:migrate (postgres connection string from the supabase dashboard)
SUPABASE_DB_URL=
# memory | supabase. default: supabase when SUPABASE_URL and the secret key are set
DB_MODE=

# ---- supabase realtime (browser-safe) ----
# the browser only receives broadcasts on private "match:{id}" channels; it cannot send
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- llm (server only, offline scripts and optional texts) ----
LLM_ENABLED=false
# any openai-compatible endpoint, e.g. https://host/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- live demo replay (server only) ----
# a finished game replayed as live, e.g. 2027-2701404
DEMO_REPLAY_MATCH_ID=
# game seconds per real second; the replay runs at 1x while a call takes answers. keep it <= 60
DEMO_REPLAY_SPEED=15
# true: starts on boot. false: waits for the host's Start (/match/<id>?host=1)
DEMO_REPLAY_AUTOSTART=false
# host controls (start / pause / resume / skip / reset). empty turns them off
HOST_TOKEN=
# how long a call takes answers, in real seconds
CALL_ANSWER_SECONDS=20

# ---- tuning (server only) ----
# simulated seasons per forecast
SIM_RUNS=10000
# the team the home page follows, by the slug in its liiga team id ("495643563:kärpät")
FAVORITE_TEAM=kärpät
# the match db:seed puts demo comments and points on
SEED_MATCH_ID=2027-2701404
# false: guests see an empty profile instead of the seeded demo fan
DEMO_PROFILE=true

# ---- browser-safe ----
# true: the pages use the bundled mock data instead of the api
VITE_USE_MOCKS=false
